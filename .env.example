# The demo's secrets. `./setup.sh` copies this to .env (git-ignored) and fills
# each one with a freshly generated value, so no two installs share them.

# The website signs persona tokens with this RSA private key (PEM, base64);
# the API trusts only the matching public key.
DEMO_JWT_PRIVATE_KEY=
DEMO_JWT_PUBLIC_KEY=

# Signs the test payment gateway's webhooks; the API checks the signature.
PAYMENT_WEBHOOK_SECRET=

# The website forwards the browser's address to the API with this key, and
# the API believes a forwarded address only with it.
BFF_FORWARDING_KEY=
